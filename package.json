{
  "name": "mock-server",
  "version": "0.1.0",
  "type": "module",
  "bin": { "mock-server": "bin/mock-server.mjs" },
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "start:test": "NODE_ENV=test node --env-file-if-exists=.env --import tsx server/index.ts",
    "cli": "node bin/mock-server.mjs",
    "fixtures:validate": "mockoon-cli validate --data providers/*.json providers/marketing-app/*.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.2",
    "@libsql/client": "^0.18.0",
    "@mockoon/cli": "9.10.0",
    "fastify": "^5.6.2",
    "http-proxy": "^1.18.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
